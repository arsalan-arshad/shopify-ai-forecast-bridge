# Server Configuration
PORT=3005
NODE_ENV=development

# Shopify App Shared Secret (for HMAC Webhook Validation)
SHOPIFY_WEBHOOK_SECRET=shpss_sample_shared_hmac_secret_key_12345

# Salesforce Connection (Direct Username/Password + Token or JWT)
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_USERNAME=admin@example.com
SALESFORCE_PASSWORD=SuperSecretPassword123
SALESFORCE_SECURITY_TOKEN=abcdef1234567890abcdef
SALESFORCE_CONSUMER_KEY=3MVG9...sample_client_id
SALESFORCE_CONSUMER_SECRET=sample_client_secret

# AI BYOK Configuration (Optional - for in-gateway chat grounding)
GEMINI_API_KEY=AIzaSy...your_gemini_api_key
ANTHROPIC_API_KEY=sk-ant-...your_claude_api_key

# Inventory Forecasting Thresholds
DEFAULT_LEAD_TIME_DAYS=14
CRITICAL_DAYS_OF_COVER_THRESHOLD=7
WARNING_DAYS_OF_COVER_THRESHOLD=14
